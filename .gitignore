# --- Monorepo ignores (no identifiable local config/secrets) ---

# Secrets / runtime config
**/config.secrets.json
**/config.json
**/*.env
**/.env*

# Logs / runtime artifacts
**/_run/
**/_logs/
**/*.log
**/*.db
**/config/**/data/

# Build artifacts
**/build/
**/dist/
**/node_modules/
opcbridge-report/vendor/
/package-lock.json
**/*.o
**/*.a
**/*.so

# Workspace files
*.code-workspace

# Built binaries (do not commit)
opcbridge/opcbridge
opcbridge/opcbridge-alarms/opcbridge-alarms
opcbridge-alarms/opcbridge-alarms
opcbridge-alarms/opcbridge-alarms.new
opcbridge-alarms/voice-modem-test
opcbridge-logger/opcbridge-logger
# Legacy build artifacts left by pre-rename worktrees.
opcbridge-reporter/opcbridge-reporter
opcbridge-historian/opcbridge-historian

# HMI local-only artifacts
opcbridge-hmi/passwords.jsonc
opcbridge-hmi/audit.jsonl
opcbridge-logger/opcbridge_logger
opcbridge-reporter/opcbridge_reporter
