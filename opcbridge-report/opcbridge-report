#!/usr/bin/env php
<?php
declare(strict_types=1);

const OPCBRIDGE_REPORT_FORMATS = ['xlsx', 'csv'];

function fail(string $message, int $code = 1): never
{
    fwrite(STDERR, "opcbridge-report: {$message}\n");
    exit($code);
}

function parse_args(array $argv): array
{
    $command = $argv[1] ?? '';
    $options = [];
    for ($i = 2; $i < count($argv); $i++) {
        $arg = (string)$argv[$i];
        if (!str_starts_with($arg, '--')) {
            fail("Unexpected argument: {$arg}", 2);
        }
        $name = substr($arg, 2);
        if ($name === 'allow-unpublished') {
            $options[$name] = true;
            continue;
        }
        if ($i + 1 >= count($argv)) {
            fail("Missing value for --{$name}", 2);
        }
        $options[$name] = (string)$argv[++$i];
    }
    return [$command, $options];
}

function option(array $options, string $name, ?string $default = null): string
{
    $value = isset($options[$name]) ? trim((string)$options[$name]) : '';
    if ($value === '' && $default === null) {
        fail("--{$name} is required", 2);
    }
    return $value !== '' ? $value : (string)$default;
}

function load_reports(string $path): array
{
    if (!is_file($path)) {
        fail("Definitions file not found: {$path}");
    }
    $raw = file_get_contents($path);
    if ($raw === false) {
        fail("Unable to read definitions: {$path}");
    }
    try {
        $root = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
    } catch (Throwable $e) {
        fail("Invalid definitions JSON: {$e->getMessage()}");
    }
    $reports = is_array($root['reports'] ?? null) ? $root['reports'] : [];
    return array_values(array_filter($reports, 'is_array'));
}

function public_report(array $report): array
{
    return [
        'id' => (string)($report['id'] ?? ''),
        'name' => (string)($report['name'] ?? $report['id'] ?? ''),
        'description' => (string)($report['description'] ?? ''),
        'period' => (string)($report['period'] ?? 'month'),
        'interval_minutes' => (int)($report['interval_minutes'] ?? 60),
        'group_by' => (string)($report['group_by'] ?? 'day'),
        'timezone' => (string)($report['timezone'] ?? 'UTC'),
        'formats' => array_values(array_intersect(
            OPCBRIDGE_REPORT_FORMATS,
            is_array($report['formats'] ?? null) ? $report['formats'] : ['xlsx']
        )),
    ];
}

function validate_report(array $report): array
{
    $id = trim((string)($report['id'] ?? ''));
    if ($id === '' || !preg_match('/^[A-Za-z0-9][A-Za-z0-9_.-]*$/', $id)) {
        fail('Report id is missing or invalid');
    }
    if (!in_array(($report['period'] ?? 'month'), ['daily', 'month', 'yearly', 'custom'], true)) {
        fail("Report '{$id}' uses an unsupported period");
    }
    $intervalMinutes = (int)($report['interval_minutes'] ?? 60);
    if (!in_array($intervalMinutes, [1, 5, 10, 15, 30, 60], true)) {
        fail("Report '{$id}' uses an unsupported daily row interval");
    }
    $report['interval_minutes'] = $intervalMinutes;
    $timezone = (string)($report['timezone'] ?? 'UTC');
    try {
        new DateTimeZone($timezone);
    } catch (Throwable) {
        fail("Report '{$id}' has invalid timezone '{$timezone}'");
    }
    $validColumn = function(mixed $value, string $fallback = ''): string {
        $column = strtoupper(trim((string)$value));
        if (!preg_match('/^[A-Z]{1,3}$/', $column)) return $fallback;
        $index = 0;
        foreach (str_split($column) as $character) $index = $index * 26 + ord($character) - 64;
        return $index >= 1 && $index <= 16384 ? $column : $fallback;
    };
    $validCell = function(mixed $value, string $fallback = '') use ($validColumn): string {
        $cell = strtoupper(trim((string)$value));
        if (!preg_match('/^([A-Z]{1,3})([1-9][0-9]{0,6})$/', $cell, $matches)) return $fallback;
        return $validColumn($matches[1]) !== '' && (int)$matches[2] <= 1048576 ? $cell : $fallback;
    };
    $validRange = function(mixed $value, string $fallback = '') use ($validCell): string {
        $parts = explode(':', strtoupper(trim((string)$value)));
        if (count($parts) < 1 || count($parts) > 2) return $fallback;
        $start = $validCell($parts[0]);
        $end = $validCell($parts[1] ?? $parts[0]);
        if ($start === '' || $end === '') return $fallback;
        preg_match('/^([A-Z]+)(\d+)$/', $start, $a);
        preg_match('/^([A-Z]+)(\d+)$/', $end, $b);
        $number = static function(string $column): int { $n = 0; foreach (str_split($column) as $c) $n = $n * 26 + ord($c) - 64; return $n; };
        if ($number($a[1]) > $number($b[1]) || (int)$a[2] > (int)$b[2]) return $fallback;
        return $start === $end ? $start : "{$start}:{$end}";
    };
    $layout = is_array($report['layout'] ?? null) ? $report['layout'] : [];
    $worksheet = trim((string)($layout['worksheet'] ?? 'Report')) ?: 'Report';
    if (strlen($worksheet) > 31 || preg_match('/[\\\\\/?*\[\]:]/', $worksheet)) {
        fail("Report '{$id}' has an invalid worksheet name");
    }
    $placedInput = is_array($layout['placed_cells'] ?? null) ? $layout['placed_cells'] : null;
    if ($placedInput === null) {
        $placedInput = [];
        $addSystem = static function(mixed $target, string $value, string $dateFormat = '') use (&$placedInput): void {
            if (trim((string)$target) !== '') $placedInput[] = ['target' => $target, 'type' => 'system', 'value' => $value, 'date_format' => $dateFormat];
        };
        $addSystem(array_key_exists('title_cell', $layout) ? $layout['title_cell'] : 'A1', 'report_name');
        $addSystem(array_key_exists('description_cell', $layout) ? $layout['description_cell'] : 'A2', 'report_description');
        $dateDisplay = (string)($layout['date_display'] ?? 'combined');
        if ($dateDisplay === 'combined') $addSystem($layout['period_cell'] ?? 'A3', 'period_label');
        if ($dateDisplay === 'separate') {
            $addSystem($layout['start_date_cell'] ?? 'A3', 'start_date', 'mm/dd/yyyy');
            $addSystem($layout['end_date_cell'] ?? 'B3', 'end_date', 'mm/dd/yyyy');
        }
        foreach (is_array($layout['fields'] ?? null) ? $layout['fields'] : [] as $field) {
            $placedInput[] = ['target' => $field['cell'] ?? '', 'type' => 'text', 'text' => $field['text'] ?? ''];
        }
    }
    $placedCells = [];
    $systemValues = ['report_name', 'report_description', 'period_label', 'start_date', 'end_date', 'generated_at', 'timezone'];
    foreach (array_slice($placedInput, 0, 100) as $index => $item) {
        $target = $validRange($item['target'] ?? '');
        $type = (string)($item['type'] ?? 'text');
        if ($target === '' || !in_array($type, ['system', 'text', 'formula'], true)) fail("Report '{$id}' placed cell " . ($index + 1) . ' is invalid');
        $placed = ['target' => $target, 'type' => $type];
        if ($type === 'system') {
            $placed['value'] = (string)($item['value'] ?? '');
            if (!in_array($placed['value'], $systemValues, true)) fail("Report '{$id}' placed cell " . ($index + 1) . ' has an invalid standard value');
            $placed['date_format'] = substr(trim((string)($item['date_format'] ?? '')), 0, 100);
        } elseif ($type === 'text') {
            $placed['text'] = substr((string)($item['text'] ?? ''), 0, 2000);
            if (trim($placed['text']) === '') fail("Report '{$id}' placed cell " . ($index + 1) . ' requires text');
        } else {
            $placed['expression'] = substr(trim((string)($item['expression'] ?? '')), 0, 4000);
            if ($placed['expression'] === '') fail("Report '{$id}' placed cell " . ($index + 1) . ' requires a formula');
            $placed['precision'] = max(0, min(10, (int)($item['precision'] ?? 2)));
        }
        $placedCells[] = $placed;
    }
    $rangeBounds = static function(string $target): array {
        $parts = explode(':', $target); $end = $parts[1] ?? $parts[0];
        $parse = static function(string $cell): array {
            preg_match('/^([A-Z]+)(\d+)$/', $cell, $match); $column = 0;
            foreach (str_split($match[1]) as $character) $column = $column * 26 + ord($character) - 64;
            return ['column' => $column, 'row' => (int)$match[2]];
        };
        return ['start' => $parse($parts[0]), 'end' => $parse($end)];
    };
    foreach ($placedCells as $index => $item) {
        $a = $rangeBounds($item['target']);
        for ($otherIndex = 0; $otherIndex < $index; $otherIndex++) {
            $b = $rangeBounds($placedCells[$otherIndex]['target']);
            if ($a['start']['row'] <= $b['end']['row'] && $a['end']['row'] >= $b['start']['row'] &&
                $a['start']['column'] <= $b['end']['column'] && $a['end']['column'] >= $b['start']['column']) {
                fail("Report '{$id}' placed cells " . ($otherIndex + 1) . ' and ' . ($index + 1) . ' overlap');
            }
        }
    }
    $report['layout'] = [
        'worksheet' => $worksheet,
        'table_start_row' => max(1, min(10000, (int)($layout['table_start_row'] ?? 5))),
        'table_start_column' => $validColumn($layout['table_start_column'] ?? 'A', 'A'),
        'include_header_row' => ($layout['include_header_row'] ?? true) !== false,
        'summary_gap_rows' => max(0, min(100, (int)($layout['summary_gap_rows'] ?? 0))),
        'summary_placement' => (string)($layout['summary_placement'] ?? 'after_data') === 'fixed' ? 'fixed' : 'after_data',
        'summary_start_row' => max(1, min(10000, (int)($layout['summary_start_row'] ?? 40))),
        'placed_cells' => $placedCells,
    ];
    $template = is_array($report['template'] ?? null) ? $report['template'] : null;
    if ($template !== null) {
        $storedId = strtolower(trim((string)($template['stored_id'] ?? '')));
        if (!preg_match('/^[a-f0-9]{64}$/', $storedId)) fail("Report '{$id}' has an invalid template identifier");
        $filename = basename((string)($template['filename'] ?? 'template.xlsx'));
        if (!str_ends_with(strtolower($filename), '.xlsx')) fail("Report '{$id}' template must be an .xlsx file");
        $report['template'] = [
            'enabled' => ($template['enabled'] ?? false) === true,
            'filename' => $filename,
            'stored_id' => $storedId,
            'checksum' => $storedId,
            'size' => max(0, (int)($template['size'] ?? 0)),
            'uploaded_at' => (string)($template['uploaded_at'] ?? ''),
        ];
    } else {
        $report['template'] = null;
    }
    $columns = $report['columns'] ?? null;
    if (!is_array($columns) || count($columns) < 1) {
        fail("Report '{$id}' must contain at least one column");
    }
    $dataSource = is_array($report['data_source'] ?? null) ? $report['data_source'] : [];
    $usedIds = [];
    foreach ($columns as $index => &$column) {
        if (!is_array($column)) {
            fail("Report '{$id}' column {$index} is invalid");
        }
        $columnId = trim((string)($column['id'] ?? ''));
        if ($columnId === '' || !preg_match('/^[A-Za-z0-9][A-Za-z0-9_.-]*$/', $columnId)) {
            $columnId = 'column_' . ($index + 1);
        }
        if (isset($usedIds[$columnId])) fail("Report '{$id}' contains duplicate column id '{$columnId}'");
        $usedIds[$columnId] = true;
        $column['id'] = $columnId;
        $column['visible'] = ($column['visible'] ?? true) !== false;
        $column['sheet_column'] = $validColumn($column['sheet_column'] ?? '');
        $source = (string)($column['source'] ?? 'historian');
        if ($source === 'calculated') {
            $expression = trim((string)($column['expression'] ?? ''));
            if ($expression === '') fail("Report '{$id}' calculated column {$index} requires a formula");
            $column['expression'] = $expression;
        } elseif ($source === 'historian') {
            if (trim((string)($column['connection_id'] ?? '')) === '' ||
                trim((string)($column['tag_name'] ?? '')) === '') {
                fail("Report '{$id}' column {$index} requires connection_id and tag_name");
            }
        } elseif ($source === 'database') {
            foreach (['database_id', 'table', 'time_column', 'field'] as $required) {
                if (trim((string)($column[$required] ?? '')) === '' && isset($dataSource[$required])) {
                    $column[$required] = $dataSource[$required];
                }
                if (trim((string)($column[$required] ?? '')) === '') {
                    fail("Report '{$id}' database column {$index} requires {$required}");
                }
            }
            $column['layout'] = (string)($column['layout'] ?? $dataSource['layout'] ?? 'wide');
            if ($column['layout'] === 'category') {
                $column['category_column'] = (string)($column['category_column'] ?? $dataSource['category_column'] ?? '');
                if ($column['category_column'] === '') {
                    fail("Report '{$id}' database column {$index} requires category_column");
                }
            }
            $aggregation = (string)($column['aggregation'] ?? 'last');
            if (!in_array($aggregation, ['last', 'last_nonzero', 'first', 'change', 'avg', 'min', 'max', 'sum', 'count'], true)) {
                fail("Report '{$id}' column {$index} uses an unsupported aggregation");
            }
        } else {
            fail("Report '{$id}' column {$index} uses an unsupported source");
        }
    }
    unset($column);
    $report['columns'] = $columns;
    if (!array_filter($columns, fn(array $item): bool => ($item['visible'] ?? true) !== false)) {
        fail("Report '{$id}' must show at least one column");
    }
    $columnNumber = function(string $column): int {
        $number = 0;
        foreach (str_split($column) as $character) $number = $number * 26 + ord($character) - 64;
        return $number;
    };
    $tableColumnNumber = $columnNumber($report['layout']['table_start_column']);
    $occupiedColumns = [$tableColumnNumber => true];
    $visibleIndex = 0;
    foreach ($columns as $column) {
        if (($column['visible'] ?? true) === false) continue;
        $sheetColumnNumber = ($column['sheet_column'] ?? '') !== ''
            ? $columnNumber($column['sheet_column']) : $tableColumnNumber + $visibleIndex + 1;
        if ($sheetColumnNumber > 16384 || isset($occupiedColumns[$sheetColumnNumber])) {
            fail("Report '{$id}' contains overlapping or invalid spreadsheet column placement");
        }
        $occupiedColumns[$sheetColumnNumber] = true;
        $visibleIndex++;
    }
    $summaryCalculations = ['none', 'sum', 'avg', 'min', 'max', 'first', 'last', 'count', 'missing', 'formula'];
    $summaries = is_array($report['summaries'] ?? null) ? array_slice($report['summaries'], 0, 20) : [];
    foreach ($summaries as $index => &$summary) {
        if (!is_array($summary) || trim((string)($summary['label'] ?? '')) === '') {
            fail("Report '{$id}' summary row " . ($index + 1) . " requires a label");
        }
        $calculations = is_array($summary['calculations'] ?? null) ? $summary['calculations'] : [];
        $formulas = is_array($summary['formulas'] ?? null) ? $summary['formulas'] : [];
        $precisions = is_array($summary['precisions'] ?? null) ? $summary['precisions'] : [];
        $summary['label'] = trim((string)$summary['label']);
        $summary['calculations'] = [];
        $summary['formulas'] = [];
        $summary['precisions'] = [];
        foreach ($columns as $columnIndex => $_column) {
            $calculation = strtolower(trim((string)($calculations[$columnIndex] ?? 'none')));
            $calculation = in_array($calculation, $summaryCalculations, true) ? $calculation : 'none';
            $formula = trim((string)($formulas[$columnIndex] ?? ''));
            if ($calculation === 'formula') {
                if ($formula === '') fail("Report '{$id}' summary row " . ($index + 1) . " requires a formula");
                try {
                    (new ReportExpressionParser())->parse($formula);
                } catch (Throwable $e) {
                    fail("Report '{$id}' summary row " . ($index + 1) . " formula error: " . $e->getMessage());
                }
            }
            $summary['calculations'][] = $calculation;
            $summary['formulas'][] = $formula;
            $precision = $precisions[$columnIndex] ?? null;
            $summary['precisions'][] = $precision === null || $precision === ''
                ? null : max(0, min(10, (int)$precision));
        }
    }
    unset($summary);
    $report['summaries'] = $summaries;
    return $report;
}

function report_range(array $report, array $options): array
{
    $period = (string)($report['period'] ?? 'month');
    $timezone = (string)($report['timezone'] ?? 'UTC');
    $tz = new DateTimeZone($timezone);
    $value = option($options, 'period-value', $options['month'] ?? '');
    if ($period === 'daily') {
        if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $value)) fail('--period-value must use YYYY-MM-DD', 2);
        $start = new DateTimeImmutable("{$value} 00:00:00", $tz);
        $intervalMinutes = (int)($report['interval_minutes'] ?? 60);
        return [$start, $start->modify('+1 day'), "minute:{$intervalMinutes}", $value];
    }
    if ($period === 'yearly') {
        if (!preg_match('/^\d{4}$/', $value)) fail('--period-value must use YYYY', 2);
        $start = new DateTimeImmutable("{$value}-01-01 00:00:00", $tz);
        return [$start, $start->modify('+1 year'), 'month', $value];
    }
    if ($period === 'custom') {
        $startValue = option($options, 'start-date');
        $endValue = option($options, 'end-date');
        if (!preg_match('/^\d{4}-\d{2}-\d{2}$/', $startValue) || !preg_match('/^\d{4}-\d{2}-\d{2}$/', $endValue)) {
            fail('--start-date and --end-date must use YYYY-MM-DD', 2);
        }
        $start = new DateTimeImmutable("{$startValue} 00:00:00", $tz);
        $endDay = new DateTimeImmutable("{$endValue} 00:00:00", $tz);
        if ($endDay < $start) fail('--end-date must not be earlier than --start-date', 2);
        $group = in_array(($report['group_by'] ?? 'day'), ['hour', 'day', 'month', 'raw'], true)
            ? (string)$report['group_by'] : 'day';
        return [$start, $endDay->modify('+1 day'), $group, "{$startValue}-to-{$endValue}"];
    }
    if (!preg_match('/^(\d{4})-(\d{2})$/', $value, $matches)) fail('--period-value must use YYYY-MM', 2);
    $year = (int)$matches[1];
    $monthNumber = (int)$matches[2];
    if ($year < 2000 || $year > 2100 || $monthNumber < 1 || $monthNumber > 12) fail('Report month is outside the supported range', 2);
    $start = new DateTimeImmutable(sprintf('%04d-%02d-01 00:00:00', $year, $monthNumber), $tz);
    return [$start, $start->modify('first day of next month'), 'day', $value];
}

function bucket_key(int $timestampMs, DateTimeZone $timezone, string $group): string
{
    $date = (new DateTimeImmutable('@' . intdiv($timestampMs, 1000)))->setTimezone($timezone);
    if (str_starts_with($group, 'minute:')) {
        $interval = max(1, (int)substr($group, 7));
        $minute = intdiv((int)$date->format('i'), $interval) * $interval;
        return $date->format('Y-m-d H:') . str_pad((string)$minute, 2, '0', STR_PAD_LEFT);
    }
    return match ($group) {
        'hour' => $date->format('Y-m-d H:00'),
        'month' => $date->format('Y-m'),
        default => $date->format('Y-m-d'),
    };
}

function bucket_step(string $group): string
{
    if (str_starts_with($group, 'minute:')) {
        return '+' . max(1, (int)substr($group, 7)) . ' minutes';
    }
    return match ($group) {
        'hour' => '+1 hour',
        'month' => '+1 month',
        default => '+1 day',
    };
}

function bucket_label(DateTimeImmutable $date, string $group): string
{
    if (str_starts_with($group, 'minute:')) {
        return $date->format('Y-m-d H:i');
    }
    return match ($group) {
        'hour' => $date->format('Y-m-d H:00'),
        'month' => $date->format('Y-m'),
        default => $date->format('Y-m-d'),
    };
}

function http_json(string $url): array
{
    $context = stream_context_create([
        'http' => [
            'method' => 'GET',
            'header' => "Accept: application/json\r\n",
            'ignore_errors' => true,
            'timeout' => 30,
        ],
    ]);
    $raw = @file_get_contents($url, false, $context);
    $status = 0;
    foreach (($http_response_header ?? []) as $header) {
        if (preg_match('#^HTTP/\S+\s+(\d+)#', $header, $match)) {
            $status = (int)$match[1];
        }
    }
    if ($raw === false) {
        fail("Historian request failed: {$url}");
    }
    try {
        $json = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
    } catch (Throwable $e) {
        fail("Historian returned invalid JSON: {$e->getMessage()}");
    }
    if ($status < 200 || $status >= 300 || !($json['ok'] ?? false)) {
        fail('Historian query failed: ' . (string)($json['error'] ?? "HTTP {$status}"));
    }
    return $json;
}

function http_post_json(string $url, array $body): array
{
    $context = stream_context_create([
        'http' => [
            'method' => 'POST',
            'header' => "Accept: application/json\r\nContent-Type: application/json\r\n",
            'content' => json_encode($body, JSON_UNESCAPED_SLASHES),
            'ignore_errors' => true,
            'timeout' => 30,
        ],
    ]);
    $raw = @file_get_contents($url, false, $context);
    $status = 0;
    foreach (($http_response_header ?? []) as $header) {
        if (preg_match('#^HTTP/\S+\s+(\d+)#', $header, $match)) $status = (int)$match[1];
    }
    if ($raw === false) fail("Logger request failed: {$url}");
    try {
        $json = json_decode($raw, true, 512, JSON_THROW_ON_ERROR);
    } catch (Throwable $e) {
        fail("Logger returned invalid JSON: {$e->getMessage()}");
    }
    if ($status < 200 || $status >= 300 || !($json['ok'] ?? false)) {
        fail('Logger query failed: ' . (string)($json['error'] ?? "HTTP {$status}"));
    }
    return $json;
}

function historian_daily_last(
    string $baseUrl,
    array $column,
    DateTimeImmutable $start,
    DateTimeImmutable $end,
    DateTimeZone $timezone,
    string $group
): array {
    $query = http_build_query([
        'connection_id' => (string)$column['connection_id'],
        'tag_name' => (string)$column['tag_name'],
        'from_ms' => $start->getTimestamp() * 1000,
        'to_ms' => ($end->getTimestamp() * 1000) - 1,
        'limit' => 100000,
    ], '', '&', PHP_QUERY_RFC3986);
    $json = http_json(rtrim($baseUrl, '/') . '/query?' . $query);
    $daily = [];
    foreach (($json['points'] ?? []) as $point) {
        if (!is_array($point) || !isset($point['ts_ms']) || !array_key_exists('value', $point)) {
            continue;
        }
        $timestampMs = (int)$point['ts_ms'];
        $date = bucket_key($timestampMs, $timezone, $group);
        if (!isset($daily[$date]) || $timestampMs > $daily[$date]['ts_ms']) {
            $daily[$date] = [
                'ts_ms' => $timestampMs,
                'value' => $point['value'],
            ];
        }
    }
    return $daily;
}

function aggregate_values(array $points, string $aggregation): mixed
{
    $points = array_values(array_filter($points, fn(array $point): bool => $point['value'] !== null));
    if ($aggregation === 'count') return count($points);
    if (!$points) return null;
    if ($aggregation === 'first') return $points[0]['value'];
    if ($aggregation === 'last') return $points[count($points) - 1]['value'];
    if ($aggregation === 'last_nonzero') {
        $lastZero = null;
        for ($index = count($points) - 1; $index >= 0; $index--) {
            $value = $points[$index]['value'];
            if (!is_numeric($value)) continue;
            if ((float)$value != 0.0) return $value;
            if ($lastZero === null) $lastZero = $value;
        }
        return $lastZero;
    }
    $values = array_values(array_filter(array_map(
        fn(array $point): mixed => is_numeric($point['value']) ? (float)$point['value'] : null,
        $points
    ), fn(mixed $value): bool => $value !== null));
    if (!$values) return null;
    return match ($aggregation) {
        'avg' => array_sum($values) / count($values),
        'min' => min($values),
        'max' => max($values),
        'sum' => array_sum($values),
        default => $values[count($values) - 1],
    };
}

final class ReportExpressionParser
{
    private array $tokens = [];
    private int $position = 0;

    public function parse(string $expression): array
    {
        $this->tokens = $this->tokenize($expression);
        $this->position = 0;
        $node = $this->parseOr();
        if ($this->peek()['type'] !== 'eof') throw new RuntimeException('Unexpected token in formula');
        return $node;
    }

    private function tokenize(string $expression): array
    {
        $tokens = [];
        $offset = 0;
        $length = strlen($expression);
        while ($offset < $length) {
            if (preg_match('/\G\s+/', $expression, $match, 0, $offset)) {
                $offset += strlen($match[0]);
                continue;
            }
            if (preg_match('/\G\[(?<ref>[A-Za-z0-9_.-]+)\]/', $expression, $match, 0, $offset)) {
                $tokens[] = ['type' => 'ref', 'value' => $match['ref']];
            } elseif (preg_match('/\G(?:\d+(?:\.\d*)?|\.\d+)(?:[eE][+-]?\d+)?/', $expression, $match, 0, $offset)) {
                $tokens[] = ['type' => 'number', 'value' => (float)$match[0]];
            } elseif (preg_match('/\G[A-Za-z_][A-Za-z0-9_]*/', $expression, $match, 0, $offset)) {
                $tokens[] = ['type' => 'word', 'value' => strtolower($match[0])];
            } elseif (preg_match('/\G(>=|<=|!=|==|[=><+\-*\/(),])/', $expression, $match, 0, $offset)) {
                $tokens[] = ['type' => 'symbol', 'value' => $match[1]];
            } else {
                throw new RuntimeException('Unsupported character in formula near: ' . substr($expression, $offset, 20));
            }
            $offset += strlen($match[0]);
        }
        $tokens[] = ['type' => 'eof', 'value' => null];
        return $tokens;
    }

    private function peek(): array { return $this->tokens[$this->position]; }
    private function take(): array { return $this->tokens[$this->position++]; }
    private function accept(string $value): bool
    {
        if ($this->peek()['value'] !== $value) return false;
        $this->position++;
        return true;
    }
    private function expect(string $value): void
    {
        if (!$this->accept($value)) throw new RuntimeException("Expected '{$value}' in formula");
    }
    private function binary(callable $next, array $operators): array
    {
        $node = $next();
        while (in_array($this->peek()['value'], $operators, true)) {
            $operator = (string)$this->take()['value'];
            $node = ['type' => 'binary', 'operator' => $operator, 'left' => $node, 'right' => $next()];
        }
        return $node;
    }
    private function parseOr(): array { return $this->binary(fn() => $this->parseAnd(), ['or']); }
    private function parseAnd(): array { return $this->binary(fn() => $this->parseCompare(), ['and']); }
    private function parseCompare(): array { return $this->binary(fn() => $this->parseAdd(), ['=', '==', '!=', '>', '<', '>=', '<=']); }
    private function parseAdd(): array { return $this->binary(fn() => $this->parseMultiply(), ['+', '-']); }
    private function parseMultiply(): array { return $this->binary(fn() => $this->parseUnary(), ['*', '/']); }
    private function parseUnary(): array
    {
        if (in_array($this->peek()['value'], ['-', '+', 'not'], true)) {
            return ['type' => 'unary', 'operator' => (string)$this->take()['value'], 'value' => $this->parseUnary()];
        }
        return $this->parsePrimary();
    }
    private function parsePrimary(): array
    {
        $token = $this->take();
        if ($token['type'] === 'number') return ['type' => 'literal', 'value' => $token['value']];
        if ($token['type'] === 'ref') return ['type' => 'reference', 'id' => $token['value']];
        if ($token['value'] === 'null') return ['type' => 'literal', 'value' => null];
        if ($token['value'] === '(') {
            $node = $this->parseOr();
            $this->expect(')');
            return $node;
        }
        if ($token['type'] === 'word' && $this->accept('(')) {
            $arguments = [];
            if (!$this->accept(')')) {
                do { $arguments[] = $this->parseOr(); } while ($this->accept(','));
                $this->expect(')');
            }
            return ['type' => 'call', 'name' => $token['value'], 'arguments' => $arguments];
        }
        throw new RuntimeException('Expected a number, column reference, function, or parenthesized expression');
    }
}

function expression_truthy(mixed $value): bool
{
    return $value !== null && (bool)$value;
}

function evaluate_expression(array $node, callable $reference): mixed
{
    if ($node['type'] === 'literal') return $node['value'];
    if ($node['type'] === 'reference') return $reference((string)$node['id']);
    if ($node['type'] === 'unary') {
        $value = evaluate_expression($node['value'], $reference);
        if ($node['operator'] === 'not') return !expression_truthy($value);
        if ($value === null || !is_numeric($value)) return null;
        return $node['operator'] === '-' ? -(float)$value : (float)$value;
    }
    if ($node['type'] === 'binary') {
        $operator = $node['operator'];
        if ($operator === 'and') {
            return expression_truthy(evaluate_expression($node['left'], $reference)) &&
                expression_truthy(evaluate_expression($node['right'], $reference));
        }
        if ($operator === 'or') {
            return expression_truthy(evaluate_expression($node['left'], $reference)) ||
                expression_truthy(evaluate_expression($node['right'], $reference));
        }
        $left = evaluate_expression($node['left'], $reference);
        $right = evaluate_expression($node['right'], $reference);
        if (in_array($operator, ['=', '==', '!=', '>', '<', '>=', '<='], true)) {
            if ($left === null || $right === null) return false;
            return match ($operator) {
                '=', '==' => $left == $right, '!=' => $left != $right,
                '>' => $left > $right, '<' => $left < $right,
                '>=' => $left >= $right, '<=' => $left <= $right,
            };
        }
        if ($left === null || $right === null || !is_numeric($left) || !is_numeric($right)) return null;
        return match ($operator) {
            '+' => (float)$left + (float)$right,
            '-' => (float)$left - (float)$right,
            '*' => (float)$left * (float)$right,
            '/' => (float)$right == 0.0 ? null : (float)$left / (float)$right,
        };
    }
    $name = (string)$node['name'];
    $arguments = $node['arguments'];
    if ($name === 'if') {
        if (count($arguments) !== 3) throw new RuntimeException('if() requires three arguments');
        return expression_truthy(evaluate_expression($arguments[0], $reference))
            ? evaluate_expression($arguments[1], $reference)
            : evaluate_expression($arguments[2], $reference);
    }
    if ($name === 'coalesce') {
        foreach ($arguments as $argument) {
            $value = evaluate_expression($argument, $reference);
            if ($value !== null) return $value;
        }
        return null;
    }
    $values = array_map(fn(array $argument): mixed => evaluate_expression($argument, $reference), $arguments);
    if ($name === 'abs') return count($values) === 1 && is_numeric($values[0]) ? abs((float)$values[0]) : null;
    if ($name === 'round') {
        if (!$values || !is_numeric($values[0])) return null;
        return round((float)$values[0], isset($values[1]) && is_numeric($values[1]) ? (int)$values[1] : 0);
    }
    $numeric = array_values(array_filter($values, 'is_numeric'));
    if ($name === 'min') return $numeric ? min(array_map('floatval', $numeric)) : null;
    if ($name === 'max') return $numeric ? max(array_map('floatval', $numeric)) : null;
    if ($name === 'avg') return $numeric ? array_sum(array_map('floatval', $numeric)) / count($numeric) : null;
    throw new RuntimeException("Unsupported formula function: {$name}");
}

function database_daily_values(
    string $loggerUrl,
    array $column,
    DateTimeImmutable $start,
    DateTimeImmutable $end,
    DateTimeZone $timezone,
    string $group
): array {
    $body = [
        'table' => (string)$column['table'],
        'time_column' => (string)$column['time_column'],
        'value_column' => (string)$column['field'],
        'from_ms' => $start->getTimestamp() * 1000,
        'to_ms' => $end->getTimestamp() * 1000,
        'limit' => 250000,
        'include_previous' => (string)($column['aggregation'] ?? 'last') === 'change',
    ];
    if (($column['layout'] ?? 'wide') === 'category') {
        $body['category_column'] = (string)($column['category_column'] ?? '');
        $body['category_value'] = $column['category_value'] ?? '';
    }
    $id = rawurlencode((string)$column['database_id']);
    $json = http_post_json(rtrim($loggerUrl, '/') . "/databases/{$id}/report-query", $body);
    $dailyPoints = [];
    $baseline = null;
    foreach (($json['points'] ?? []) as $point) {
        if (!is_array($point) || !isset($point['ts_ms'])) continue;
        $timestampMs = (int)$point['ts_ms'];
        if ($timestampMs < $start->getTimestamp() * 1000) {
            if ($point['value'] !== null) $baseline = $point['value'];
            continue;
        }
        $date = bucket_key((int)$point['ts_ms'], $timezone, $group);
        $dailyPoints[$date][] = ['ts_ms' => (int)$point['ts_ms'], 'value' => $point['value'] ?? null];
    }
    $daily = [];
    $aggregation = (string)($column['aggregation'] ?? 'last');
    if ($aggregation === 'change') {
        for ($day = $start; $day < $end; $day = $day->modify(bucket_step($group))) {
            $date = bucket_label($day, $group);
            $points = $dailyPoints[$date] ?? [];
            usort($points, fn(array $a, array $b): int => $a['ts_ms'] <=> $b['ts_ms']);
            $values = array_values(array_filter(array_map(
                fn(array $point): mixed => $point['value'],
                $points
            ), fn(mixed $value): bool => $value !== null));
            if (!$values) continue;
            $ending = $values[count($values) - 1];
            $change = null;
            if (is_numeric($baseline) && is_numeric($ending)) {
                $change = (float)$ending - (float)$baseline;
                if ($change < 0) {
                    $handling = (string)($column['negative_change'] ?? 'blank');
                    if ($handling === 'reset') {
                        $change = (float)$ending;
                    } elseif ($handling === 'rollover') {
                        $modulus = max(1.0, (float)($column['rollover_modulus'] ?? 65536));
                        $change = ($modulus - (float)$baseline) + (float)$ending;
                    } else {
                        $change = null;
                    }
                }
            }
            $daily[$date] = ['value' => $change];
            $baseline = $ending;
        }
        return $daily;
    }
    foreach ($dailyPoints as $date => $points) {
        usort($points, fn(array $a, array $b): int => $a['ts_ms'] <=> $b['ts_ms']);
        $daily[$date] = ['value' => aggregate_values($points, $aggregation)];
    }
    return $daily;
}

function historian_raw_values(
    string $baseUrl,
    array $column,
    DateTimeImmutable $start,
    DateTimeImmutable $end
): array {
    $limit = 100000;
    $query = http_build_query([
        'connection_id' => (string)$column['connection_id'],
        'tag_name' => (string)$column['tag_name'],
        'from_ms' => $start->getTimestamp() * 1000,
        'to_ms' => ($end->getTimestamp() * 1000) - 1,
        'limit' => $limit,
    ], '', '&', PHP_QUERY_RFC3986);
    $json = http_json(rtrim($baseUrl, '/') . '/query?' . $query);
    $values = [];
    $count = 0;
    foreach (($json['points'] ?? []) as $point) {
        if (!is_array($point) || !isset($point['ts_ms']) || !array_key_exists('value', $point)) continue;
        $values[(int)$point['ts_ms']] = $point['value'];
        $count++;
    }
    return ['values' => $values, 'truncated' => $count >= $limit];
}

function database_raw_values(
    string $loggerUrl,
