}

function raw_timestamp_label(int $timestampMs, DateTimeZone $timezone): string
{
    $seconds = intdiv($timestampMs, 1000);
    $milliseconds = (($timestampMs % 1000) + 1000) % 1000;
    $date = (new DateTimeImmutable('@' . $seconds))->setTimezone($timezone);
    return $date->format('Y-m-d H:i:s') . '.' . str_pad((string)$milliseconds, 3, '0', STR_PAD_LEFT);
}

function compile_report_expressions(array $report): array
{
    $parser = new ReportExpressionParser();
    $compiled = [];
    foreach ($report['columns'] as $index => $column) {
        if (($column['source'] ?? '') !== 'calculated') continue;
        try {
            $compiled[$index] = $parser->parse((string)$column['expression']);
        } catch (Throwable $e) {
            fail("Formula error in '" . (string)$column['heading'] . "': " . $e->getMessage());
        }
    }
    return $compiled;
}

function evaluate_report_row(array $report, array $baseValues, array $compiled): array
{
    $values = $baseValues;
    $indexes = [];
    foreach ($report['columns'] as $index => $column) $indexes[(string)$column['id']] = $index;
    $evaluating = [];
    $resolveIndex = function(int $index) use (&$resolveIndex, &$values, &$evaluating, $indexes, $report, $compiled): mixed {
        if (($report['columns'][$index]['source'] ?? '') !== 'calculated') return $values[$index] ?? null;
        if (array_key_exists($index, $values) && $values[$index] !== null) return $values[$index];
        if (isset($evaluating[$index])) throw new RuntimeException('Calculated columns contain a circular reference');
        $evaluating[$index] = true;
        $reference = function(string $id) use (&$resolveIndex, $indexes): mixed {
            if (!array_key_exists($id, $indexes)) throw new RuntimeException("Unknown column reference [{$id}]");
            return $resolveIndex($indexes[$id]);
        };
        $values[$index] = evaluate_expression($compiled[$index], $reference);
        unset($evaluating[$index]);
        return $values[$index];
    };
    foreach ($report['columns'] as $index => $_column) $resolveIndex($index);
    ksort($values);
    return array_values($values);
}

function build_rows(
    array $report,
    string $historianUrl,
    string $loggerUrl,
    DateTimeImmutable $start,
    DateTimeImmutable $end,
    string $group,
    int $rawRowLimit = 250000
): array {
    $timezone = new DateTimeZone((string)($report['timezone'] ?? 'UTC'));
    $compiled = compile_report_expressions($report);
    if ($group === 'raw') {
        $series = [];
        $timestamps = [];
        $truncated = false;
        foreach ($report['columns'] as $column) {
            if (($column['source'] ?? '') === 'calculated') {
                $series[] = [];
                continue;
            }
            $raw = ($column['source'] ?? 'historian') === 'database'
                ? database_raw_values($loggerUrl, $column, $start, $end)
                : historian_raw_values($historianUrl, $column, $start, $end);
            $series[] = $raw['values'];
            $truncated = $truncated || $raw['truncated'];
            foreach (array_keys($raw['values']) as $timestampMs) $timestamps[(int)$timestampMs] = true;
        }
        $timestampList = array_keys($timestamps);
        sort($timestampList, SORT_NUMERIC);
        $rowLimit = max(1, $rawRowLimit);
        if (count($timestampList) > $rowLimit) {
            $timestampList = array_slice($timestampList, 0, $rowLimit);
            $truncated = true;
        }
        $rows = [];
        foreach ($timestampList as $timestampMs) {
            $values = [];
            foreach ($series as $index => $data) {
                $value = array_key_exists($timestampMs, $data) ? $data[$timestampMs] : null;
                $multiplier = (float)($report['columns'][$index]['multiplier'] ?? 1);
                $values[] = ($value !== null && is_numeric($value)) ? ((float)$value * $multiplier) : $value;
            }
            $rows[] = [
                'date' => raw_timestamp_label((int)$timestampMs, $timezone),
                'values' => evaluate_report_row($report, $values, $compiled)
            ];
        }
        return [$rows, $truncated];
    }
    $series = [];
    foreach ($report['columns'] as $column) {
        $series[] = ($column['source'] ?? '') === 'calculated'
            ? []
            : (($column['source'] ?? 'historian') === 'database'
            ? database_daily_values($loggerUrl, $column, $start, $end, $timezone, $group)
            : historian_daily_last($historianUrl, $column, $start, $end, $timezone, $group));
    }
    $rows = [];
    for ($day = $start; $day < $end; $day = $day->modify(bucket_step($group))) {
        $dateKey = bucket_label($day, $group);
        $values = [];
        foreach ($series as $index => $data) {
            $value = $data[$dateKey]['value'] ?? null;
            $multiplier = (float)($report['columns'][$index]['multiplier'] ?? 1);
            $values[] = ($value !== null && is_numeric($value)) ? ((float)$value * $multiplier) : $value;
        }
        $rows[] = ['date' => $dateKey, 'values' => evaluate_report_row($report, $values, $compiled)];
    }
    return [$rows, false];
}

function safe_filename(string $value): string
{
    $safe = preg_replace('/[^A-Za-z0-9._-]+/', '-', trim($value));
    return trim((string)$safe, '-_.') ?: 'report';
}

function calculate_summary_rows(array $report, array $rows): array
{
    $statistics = calculate_column_statistics($report, $rows);
    $columnIndexes = [];
    foreach ($report['columns'] as $columnIndex => $column) {
        $columnIndexes[(string)$column['id']] = $columnIndex;
    }
    $parser = new ReportExpressionParser();
    $summaryRows = [];
    foreach (($report['summaries'] ?? []) as $summary) {
        $values = [];
        foreach ($report['columns'] as $columnIndex => $_column) {
            $calculation = (string)($summary['calculations'][$columnIndex] ?? 'none');
            $stats = $statistics[$columnIndex];
            $value = null;
            if (in_array($calculation, ['count', 'missing', 'first', 'last', 'sum', 'avg', 'min', 'max'], true)) {
                $value = summary_statistic_value($calculation, $stats);
            } elseif ($calculation === 'formula') {
                $formula = (string)($summary['formulas'][$columnIndex] ?? '');
                try {
                    $node = resolve_summary_aggregates($parser->parse($formula), $statistics, $columnIndexes);
                    $value = evaluate_expression($node, function(string $id): mixed {
                        throw new RuntimeException("Use an aggregate such as sum([{$id}]) in a summary formula");
                    });
                } catch (Throwable $e) {
                    fail("Summary formula error in '" . (string)$summary['label'] . "': " . $e->getMessage());
                }
            }
            $values[] = $value;
        }
        $summaryRows[] = [
            'label' => (string)$summary['label'], 'values' => $values,
            'precisions' => array_map(fn(mixed $precision): ?int => $precision === null ? null : (int)$precision, $summary['precisions'] ?? []),
        ];
    }
    return $summaryRows;
}

function calculate_column_statistics(array $report, array $rows): array
{
    $statistics = [];
    foreach ($report['columns'] as $columnIndex => $_column) {
        $stats = [
            'count' => 0, 'missing' => 0, 'first' => null, 'last' => null,
            'numeric_count' => 0, 'sum' => 0.0, 'min' => null, 'max' => null,
        ];
        foreach ($rows as $row) {
            $value = $row['values'][$columnIndex] ?? null;
            if ($value === null) {
                $stats['missing']++;
                continue;
            }
            if ($stats['count'] === 0) $stats['first'] = $value;
            $stats['last'] = $value;
            $stats['count']++;
            if (is_numeric($value)) {
                $number = (float)$value;
                $stats['numeric_count']++;
                $stats['sum'] += $number;
                $stats['min'] = $stats['min'] === null ? $number : min($stats['min'], $number);
                $stats['max'] = $stats['max'] === null ? $number : max($stats['max'], $number);
            }
        }
        $statistics[] = $stats;
    }
    return $statistics;
}

function calculate_placed_cells(array $report, array $rows, string $periodLabel, DateTimeImmutable $start, DateTimeImmutable $end): array
{
    $statistics = calculate_column_statistics($report, $rows);
    $indexes = [];
    foreach ($report['columns'] as $index => $column) $indexes[(string)$column['id']] = $index;
    $parser = new ReportExpressionParser();
    $values = [
        'report_name' => (string)($report['name'] ?? $report['id']),
        'report_description' => (string)($report['description'] ?? ''), 'period_label' => $periodLabel,
        'start_date' => $start, 'end_date' => $end->modify('-1 second'),
        'generated_at' => new DateTimeImmutable('now', new DateTimeZone((string)($report['timezone'] ?? 'UTC'))),
        'timezone' => (string)($report['timezone'] ?? 'UTC'),
    ];
    $result = [];
    foreach (($report['layout']['placed_cells'] ?? []) as $index => $item) {
        $entry = ['target' => $item['target'], 'type' => $item['type'], 'is_date' => false,
            'date_format' => (string)($item['date_format'] ?? ''), 'precision' => $item['type'] === 'formula' ? (int)($item['precision'] ?? 2) : null];
        if ($item['type'] === 'system') {
            $entry['value'] = $values[$item['value']] ?? null;
            $entry['system_value'] = $item['value'];
            $entry['is_date'] = $entry['value'] instanceof DateTimeInterface;
        } elseif ($item['type'] === 'text') $entry['value'] = (string)$item['text'];
        else {
            try {
                $node = resolve_summary_aggregates($parser->parse((string)$item['expression']), $statistics, $indexes);
                $entry['value'] = evaluate_expression($node, function(string $id): mixed {
                    throw new RuntimeException("Use an aggregate such as sum([{$id}]) in a placed-cell formula");
                });
            } catch (Throwable $e) { fail('Placed cell formula error at ' . $item['target'] . ': ' . $e->getMessage()); }
        }
        $result[] = $entry;
    }
    return $result;
}

function summary_statistic_value(string $name, array $stats): mixed
{
    return match ($name) {
        'count' => $stats['count'],
        'missing' => $stats['missing'],
        'first' => $stats['count'] ? $stats['first'] : null,
        'last' => $stats['count'] ? $stats['last'] : null,
        'sum' => $stats['numeric_count'] ? $stats['sum'] : null,
        'avg' => $stats['numeric_count'] ? $stats['sum'] / $stats['numeric_count'] : null,
        'min' => $stats['numeric_count'] ? $stats['min'] : null,
        'max' => $stats['numeric_count'] ? $stats['max'] : null,
        default => null,
    };
}

function resolve_summary_aggregates(array $node, array $statistics, array $columnIndexes): array
{
    if (($node['type'] ?? '') === 'call') {
        $name = (string)$node['name'];
        $arguments = $node['arguments'] ?? [];
        $aggregateNames = ['sum', 'avg', 'min', 'max', 'first', 'last', 'count', 'missing'];
        if (in_array($name, $aggregateNames, true) && count($arguments) === 1 &&
            ($arguments[0]['type'] ?? '') === 'reference') {
            $id = (string)$arguments[0]['id'];
            if (!array_key_exists($id, $columnIndexes)) {
                throw new RuntimeException("Unknown column reference [{$id}]");
            }
            return ['type' => 'literal', 'value' => summary_statistic_value(
                $name, $statistics[$columnIndexes[$id]]
            )];
        }
        $node['arguments'] = array_map(
            fn(array $argument): array => resolve_summary_aggregates($argument, $statistics, $columnIndexes),
            $arguments
        );
        return $node;
    }
    if (($node['type'] ?? '') === 'binary') {
        $node['left'] = resolve_summary_aggregates($node['left'], $statistics, $columnIndexes);
        $node['right'] = resolve_summary_aggregates($node['right'], $statistics, $columnIndexes);
    } elseif (($node['type'] ?? '') === 'unary') {
        $node['value'] = resolve_summary_aggregates($node['value'], $statistics, $columnIndexes);
    }
    return $node;
}

function visible_column_indexes(array $report): array
{
    $indexes = [];
    foreach ($report['columns'] as $index => $column) {
        if (($column['visible'] ?? true) !== false) $indexes[] = $index;
    }
    return $indexes;
}

function project_report_rows(array $rows, array $indexes, string $labelKey = 'date'): array
{
    return array_map(
        function(array $row) use ($labelKey, $indexes): array {
            $projected = [
                $labelKey => $row[$labelKey],
                'values' => array_map(fn(int $index): mixed => $row['values'][$index] ?? null, $indexes),
            ];
            if (array_key_exists('precisions', $row)) {
                $projected['precisions'] = array_map(
                    fn(int $index): mixed => $row['precisions'][$index] ?? null,
                    $indexes
                );
            }
            return $projected;
        },
        $rows
    );
}

function write_csv(string $output, array $report, array $rows, array $summaryRows): void
{
    $handle = fopen($output, 'wb');
    if ($handle === false) {
        fail("Unable to create output: {$output}");
    }
    $timeHeading = ($report['group_by'] ?? 'day') === 'raw'
        ? 'Timestamp' : (($report['period'] ?? 'month') === 'daily' ? 'Time' : 'Date');
    fputcsv($handle, array_merge(
        [$timeHeading],
        array_map(fn(array $column): string => (string)($column['heading'] ?? $column['tag_name']), $report['columns'])
    ));
    foreach ($rows as $row) {
        fputcsv($handle, array_merge([$row['date']], $row['values']));
    }
    foreach ($summaryRows as $row) {
        fputcsv($handle, array_merge([$row['label']], $row['values']));
    }
    fclose($handle);
}

function write_xlsx(
    string $output,
    array $report,
    string $month,
    DateTimeImmutable $rangeStart,
    DateTimeImmutable $rangeEnd,
    array $rows,
    array $summaryRows,
    array $placedCells,
    string $autoload
): void {
    if (!is_file($autoload)) {
        fail("PhpSpreadsheet is not installed; missing {$autoload}");
    }
    require_once $autoload;

    $layout = is_array($report['layout'] ?? null) ? $report['layout'] : [];
    $template = is_array($report['template'] ?? null) ? $report['template'] : [];
    if (($template['enabled'] ?? false) === true) {
        $storedId = (string)($template['stored_id'] ?? '');
        $templateDir = rtrim((string)(getenv('OPCBRIDGE_REPORT_TEMPLATE_DIR') ?: '/var/lib/opcbridge/report/templates'), '/');
        $templatePath = $templateDir . '/' . $storedId . '.xlsx';
        if (!preg_match('/^[a-f0-9]{64}$/', $storedId) || !is_file($templatePath)) {
            fail('Enabled report template is missing or invalid');
        }
        $spreadsheet = \PhpOffice\PhpSpreadsheet\IOFactory::load($templatePath);
        $sheet = $spreadsheet->getSheetByName((string)($layout['worksheet'] ?? 'Report'));
        if ($sheet === null) fail("Template worksheet not found: " . (string)($layout['worksheet'] ?? 'Report'));
    } else {
        $spreadsheet = new \PhpOffice\PhpSpreadsheet\Spreadsheet();
        $sheet = $spreadsheet->getActiveSheet();
        $sheet->setTitle((string)($layout['worksheet'] ?? 'Report'));
    }
    $tableStartRow = (int)($layout['table_start_row'] ?? 5);
    $tableStartColumn = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::columnIndexFromString(
        (string)($layout['table_start_column'] ?? 'A')
    );
    $includeHeaderRow = ($layout['include_header_row'] ?? true) !== false;
    $columnIndexes = [];
    foreach ($report['columns'] as $index => $column) {
        $columnIndexes[] = trim((string)($column['sheet_column'] ?? '')) !== ''
            ? \PhpOffice\PhpSpreadsheet\Cell\Coordinate::columnIndexFromString((string)$column['sheet_column'])
            : $tableStartColumn + $index + 1;
    }
    $lastColumnIndex = max([$tableStartColumn, ...$columnIndexes]);
    $firstColumn = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($tableStartColumn);
    $lastColumn = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($lastColumnIndex);
    foreach ($placedCells as $placed) {
        $target = (string)$placed['target'];
        $parts = explode(':', $target);
        $cell = $parts[0];
        if (count($parts) === 2 && $parts[0] !== $parts[1]) $sheet->mergeCells($target);
        if (($placed['is_date'] ?? false) && $placed['value'] instanceof DateTimeInterface) {
            $sheet->setCellValue($cell, \PhpOffice\PhpSpreadsheet\Shared\Date::PHPToExcel($placed['value']));
            $sheet->getStyle($cell)->getNumberFormat()->setFormatCode((string)($placed['date_format'] ?: 'mm/dd/yyyy'));
        } elseif (($placed['type'] ?? '') === 'text' || is_string($placed['value'] ?? null)) {
            $sheet->setCellValueExplicit($cell, (string)($placed['value'] ?? ''), \PhpOffice\PhpSpreadsheet\Cell\DataType::TYPE_STRING);
        } else {
            $sheet->setCellValue($cell, $placed['value'] ?? null);
            if (($placed['type'] ?? '') === 'formula' && is_numeric($placed['value'] ?? null)) {
                $precision = max(0, min(10, (int)($placed['precision'] ?? 2)));
                $format = $precision > 0 ? '#,##0.' . str_repeat('0', $precision) : '#,##0';
                $sheet->getStyle($cell)->getNumberFormat()->setFormatCode($format);
            }
        }
    }

    $timeHeading = ($report['group_by'] ?? 'day') === 'raw'
        ? 'Timestamp' : (($report['period'] ?? 'month') === 'daily' ? 'Time' : 'Date');
    if ($includeHeaderRow) {
        $sheet->setCellValue("{$firstColumn}{$tableStartRow}", $timeHeading);
        foreach ($report['columns'] as $index => $column) {
            $columnLetter = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($columnIndexes[$index]);
            $sheet->setCellValue("{$columnLetter}{$tableStartRow}", (string)($column['heading'] ?? $column['tag_name']));
        }
    }

    $rowNumber = $tableStartRow + ($includeHeaderRow ? 1 : 0);
    foreach ($rows as $row) {
        if (preg_match('/^\d{4}-\d{2}-\d{2}$/', (string)$row['date'])) {
            $date = DateTimeImmutable::createFromFormat('!Y-m-d', $row['date']);
            $sheet->setCellValue("{$firstColumn}{$rowNumber}", \PhpOffice\PhpSpreadsheet\Shared\Date::PHPToExcel($date));
            $sheet->getStyle("{$firstColumn}{$rowNumber}")->getNumberFormat()->setFormatCode('mm/dd/yyyy');
        } else {
            $sheet->setCellValueExplicit(
                "{$firstColumn}{$rowNumber}",
                (string)$row['date'],
                \PhpOffice\PhpSpreadsheet\Cell\DataType::TYPE_STRING
            );
        }
        foreach ($row['values'] as $index => $value) {
            if ($value === null) {
                continue;
            }
            $cell = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($columnIndexes[$index]) . $rowNumber;
            $sheet->setCellValue($cell, $value);
            $precision = $row['precisions'][$index] ?? null;
            $precision = $precision === null
                ? max(0, min(10, (int)($report['columns'][$index]['precision'] ?? 2)))
                : max(0, min(10, (int)$precision));
            $format = $precision > 0 ? '#,##0.' . str_repeat('0', $precision) : '#,##0';
            $sheet->getStyle($cell)->getNumberFormat()->setFormatCode($format);
        }
        $rowNumber++;
    }
    $dataEndRow = $rowNumber - 1;
    $rowNumber = ($layout['summary_placement'] ?? 'after_data') === 'fixed'
        ? (int)($layout['summary_start_row'] ?? 40)
        : $rowNumber + (int)($layout['summary_gap_rows'] ?? 0);
    if ($summaryRows && $rowNumber <= $dataEndRow) {
        fail('Fixed summary starting row overlaps report table data');
    }
    $summaryStartRow = $rowNumber;
    foreach ($summaryRows as $row) {
        $sheet->setCellValue("{$firstColumn}{$rowNumber}", (string)$row['label']);
        foreach ($row['values'] as $index => $value) {
            if ($value === null) continue;
            $cell = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($columnIndexes[$index]) . $rowNumber;
            $sheet->setCellValue($cell, $value);
            $precision = $row['precisions'][$index] ?? null;
            $precision = $precision === null
                ? max(0, min(10, (int)($report['columns'][$index]['precision'] ?? 2)))
                : max(0, min(10, (int)$precision));
            $format = $precision > 0 ? '#,##0.' . str_repeat('0', $precision) : '#,##0';
            $sheet->getStyle($cell)->getNumberFormat()->setFormatCode($format);
        }
        $rowNumber++;
    }
    if ($summaryRows && ($template['enabled'] ?? false) !== true) {
        $sheet->getStyle("{$firstColumn}{$summaryStartRow}:{$lastColumn}" . ($rowNumber - 1))->getFont()->setBold(true);
        $sheet->getStyle("{$firstColumn}{$summaryStartRow}:{$lastColumn}" . ($rowNumber - 1))->getFill()
            ->setFillType(\PhpOffice\PhpSpreadsheet\Style\Fill::FILL_SOLID)
            ->getStartColor()->setARGB('FFF2F2F2');
    }

    if (($template['enabled'] ?? false) !== true) {
        foreach ($placedCells as $placed) {
            if (($placed['system_value'] ?? '') === 'report_name') {
                $sheet->getStyle((string)$placed['target'])->getFont()->setBold(true)->setSize(16);
            }
        }
    }
    if ($includeHeaderRow) {
        $sheet->getStyle("{$firstColumn}{$tableStartRow}:{$lastColumn}{$tableStartRow}")->getFont()->setBold(true);
        $sheet->getStyle("{$firstColumn}{$tableStartRow}:{$lastColumn}{$tableStartRow}")->getFill()
            ->setFillType(\PhpOffice\PhpSpreadsheet\Style\Fill::FILL_SOLID)
            ->getStartColor()->setARGB('FFD9EAF7');
        $sheet->freezePane("{$firstColumn}" . ($tableStartRow + 1));
        $sheet->setAutoFilter("{$firstColumn}{$tableStartRow}:{$lastColumn}" . max($tableStartRow, $dataEndRow));
    }
    $sheet->getColumnDimension($firstColumn)->setWidth(14);
    foreach ($columnIndexes as $columnIndex) {
        $sheet->getColumnDimension(\PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($columnIndex))->setWidth(20);
    }
    $sheet->getPageSetup()->setOrientation(\PhpOffice\PhpSpreadsheet\Worksheet\PageSetup::ORIENTATION_LANDSCAPE);
    $sheet->getPageSetup()->setFitToWidth(1)->setFitToHeight(0);

    $writer = new \PhpOffice\PhpSpreadsheet\Writer\Xlsx($spreadsheet);
    $writer->setPreCalculateFormulas(false);
    $writer->save($output);
    $spreadsheet->disconnectWorksheets();
}

function template_preview(string $templatePath, string $worksheetName, string $autoload): array
{
    if (!is_file($autoload)) fail("PhpSpreadsheet is not installed; missing {$autoload}");
    if (!is_file($templatePath)) fail('Template file was not found');
    require_once $autoload;
    $spreadsheet = \PhpOffice\PhpSpreadsheet\IOFactory::load($templatePath);
    $worksheetNames = $spreadsheet->getSheetNames();
    $sheet = $worksheetName !== '' ? $spreadsheet->getSheetByName($worksheetName) : null;
    if ($sheet === null) $sheet = $spreadsheet->getActiveSheet();
    $highestRow = min(500, max(1, $sheet->getHighestDataRow(), $sheet->getHighestRow()));
    $highestColumn = min(100, \PhpOffice\PhpSpreadsheet\Cell\Coordinate::columnIndexFromString($sheet->getHighestColumn()));
    $cells = [];
    for ($row = 1; $row <= $highestRow; $row++) {
        for ($column = 1; $column <= $highestColumn; $column++) {
            $coordinate = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($column) . $row;
            $cell = $sheet->getCell($coordinate);
            $style = $sheet->getStyle($coordinate);
            $value = $cell->getValue();
            $hasStyle = $cell->getXfIndex() !== 0;
            if (($value === null || $value === '') && !$hasStyle) continue;
            if ($cell->getDataType() === \PhpOffice\PhpSpreadsheet\Cell\DataType::TYPE_FORMULA) {
                $display = $cell->getOldCalculatedValue();
                if ($display === null) $display = $value;
            } else {
                try { $display = $cell->getFormattedValue(); } catch (Throwable) { $display = $value; }
            }
            $fontColor = $style->getFont()->getColor()->getARGB();
            $fillColor = $style->getFill()->getStartColor()->getARGB();
            $cells[] = [
                'row' => $row,
                'column' => $column,
                'value' => $display === null ? '' : (string)$display,
                'style' => [
                    'bold' => $style->getFont()->getBold(),
                    'italic' => $style->getFont()->getItalic(),
                    'size' => $style->getFont()->getSize(),
                    'color' => $fontColor,
                    'fill' => $style->getFill()->getFillType() === \PhpOffice\PhpSpreadsheet\Style\Fill::FILL_NONE ? '' : $fillColor,
                    'horizontal' => $style->getAlignment()->getHorizontal(),
                    'vertical' => $style->getAlignment()->getVertical(),
                    'wrap' => $style->getAlignment()->getWrapText(),
                ],
            ];
        }
    }
    $columnWidths = [];
    for ($column = 1; $column <= $highestColumn; $column++) {
        $letter = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::stringFromColumnIndex($column);
        $width = $sheet->getColumnDimension($letter)->getWidth();
        if ($width > 0) $columnWidths[(string)$column] = $width;
    }
    $rowHeights = [];
    for ($row = 1; $row <= $highestRow; $row++) {
        $height = $sheet->getRowDimension($row)->getRowHeight();
        if ($height > 0) $rowHeights[(string)$row] = $height;
    }
    $merges = [];
    foreach ($sheet->getMergeCells() as $range) {
        [$start, $end] = \PhpOffice\PhpSpreadsheet\Cell\Coordinate::rangeBoundaries($range);
        $merges[] = [
            'start_row' => $start[1], 'start_column' => $start[0],
            'end_row' => $end[1], 'end_column' => $end[0],
        ];
    }
    $result = [
        'worksheet' => $sheet->getTitle(),
        'worksheets' => $worksheetNames,
        'max_row' => $highestRow,
        'max_column' => $highestColumn,
        'cells' => $cells,
        'merges' => $merges,
        'column_widths' => $columnWidths,
        'row_heights' => $rowHeights,
        'truncated' => $sheet->getHighestRow() > 500 ||
            \PhpOffice\PhpSpreadsheet\Cell\Coordinate::columnIndexFromString($sheet->getHighestColumn()) > 100,
    ];
    $spreadsheet->disconnectWorksheets();
    return $result;
}

[$command, $options] = parse_args($argv);
$autoload = option($options, 'autoload', __DIR__ . '/vendor/autoload.php');
if ($command === 'template-preview') {
    echo json_encode(template_preview(
        option($options, 'template'),
        option($options, 'worksheet', ''),
        $autoload
    ), JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
}
$definitions = option($options, 'definitions', '/etc/opcbridge/report/reports.json');
$reports = load_reports($definitions);

if ($command === 'list') {
    $publishedOnly = !isset($options['allow-unpublished']);
    $items = [];
    foreach ($reports as $report) {
        if ($publishedOnly && !($report['published'] ?? false)) {
            continue;
        }
        $items[] = public_report(validate_report($report));
    }
    echo json_encode(['ok' => true, 'reports' => $items], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
}

if ($command !== 'generate' && $command !== 'preview') {
    fail('Usage: opcbridge-report list|preview|generate [options]', 2);
}

$id = option($options, 'id');
$historianUrl = option($options, 'historian-url', 'http://127.0.0.1:8096');
$loggerUrl = option($options, 'logger-url', 'http://127.0.0.1:8095');

$report = null;
foreach ($reports as $candidate) {
    if ((string)($candidate['id'] ?? '') === $id) {
        $report = validate_report($candidate);
        break;
    }
}
if ($report === null) {
    fail("Report not found: {$id}");
}
if (!($report['published'] ?? false) && !isset($options['allow-unpublished'])) {
    fail("Report is not published: {$id}");
}
[$start, $end, $group, $periodLabel] = report_range($report, $options);
$rawRowLimit = $command === 'preview' ? 5000 : 250000;
try {
    [$rows, $truncated] = build_rows($report, $historianUrl, $loggerUrl, $start, $end, $group, $rawRowLimit);
} catch (Throwable $e) {
    fail('Report calculation failed: ' . $e->getMessage());
}
$summaryRows = calculate_summary_rows($report, $rows);
$placedCells = calculate_placed_cells($report, $rows, $periodLabel, $start, $end);
$reportLayout = is_array($report['layout'] ?? null) ? $report['layout'] : [];
if ($summaryRows && ($reportLayout['summary_placement'] ?? 'after_data') === 'fixed') {
    $headerRows = ($reportLayout['include_header_row'] ?? true) !== false ? 1 : 0;
    $lastDataRow = (int)($reportLayout['table_start_row'] ?? 5) + $headerRows + count($rows) - 1;
    if ((int)($reportLayout['summary_start_row'] ?? 40) <= $lastDataRow) {
        fail('Fixed summary starting row overlaps report table data');
    }
}
$visibleIndexes = visible_column_indexes($report);
$outputReport = $report;
$outputReport['columns'] = array_map(fn(int $index): array => $report['columns'][$index], $visibleIndexes);
$outputRows = project_report_rows($rows, $visibleIndexes);
$outputSummaryRows = project_report_rows($summaryRows, $visibleIndexes, 'label');

if ($command === 'preview') {
    echo json_encode([
        'ok' => true,
        'id' => $id,
        'name' => (string)($report['name'] ?? $id),
        'description' => (string)($report['description'] ?? ''),
        'period' => (string)($report['period'] ?? 'month'),
        'interval_minutes' => (int)($report['interval_minutes'] ?? 60),
        'period_label' => $periodLabel,
        'start_date' => $start->format('Y-m-d'),
        'end_date' => $end->modify('-1 day')->format('Y-m-d'),
        'group_by' => $group,
        'timezone' => (string)($report['timezone'] ?? 'UTC'),
        'layout' => $report['layout'] ?? [],
        'placed_cells' => array_map(static function(array $item): array {
            $value = $item['value'] ?? null;
            if ($value instanceof DateTimeInterface) $value = $value->format(($item['system_value'] ?? '') === 'generated_at' ? 'Y-m-d H:i:s' : 'Y-m-d');
            return ['target' => $item['target'], 'value' => $value, 'type' => $item['type'], 'is_date' => $item['is_date'],
                'date_format' => $item['date_format'], 'precision' => $item['precision']];
        }, $placedCells),
        'truncated' => $truncated,
        'row_limit' => $group === 'raw' ? $rawRowLimit : null,
        'columns' => array_map(
            fn(array $column): array => [
                'heading' => (string)($column['heading'] ?? $column['tag_name'] ?? $column['field'] ?? ''),
                'source' => (string)($column['source'] ?? 'historian'),
                'connection_id' => (string)($column['connection_id'] ?? $column['database_id'] ?? ''),
                'tag_name' => (string)($column['tag_name'] ?? $column['field'] ?? ''),
                'precision' => max(0, min(10, (int)($column['precision'] ?? 2))),
                'sheet_column' => (string)($column['sheet_column'] ?? ''),
            ],
            $outputReport['columns']
        ),
        'rows' => $outputRows,
        'summary_rows' => $outputSummaryRows,
    ], JSON_UNESCAPED_SLASHES) . "\n";
    exit(0);
}

$format = strtolower(option($options, 'format', 'xlsx'));
$output = option($options, 'output');
if (!in_array($format, OPCBRIDGE_REPORT_FORMATS, true)) {
    fail("Unsupported format: {$format}", 2);
}
$formats = is_array($report['formats'] ?? null) ? $report['formats'] : ['xlsx'];
if (!in_array($format, $formats, true)) {
    fail("Report '{$id}' does not publish {$format} output");
}

$outputDir = dirname($output);
if (!is_dir($outputDir) && !mkdir($outputDir, 0750, true) && !is_dir($outputDir)) {
    fail("Unable to create output directory: {$outputDir}");
}
if ($format === 'csv') {
    write_csv($output, $outputReport, $outputRows, $outputSummaryRows);
} else {
    write_xlsx($output, $outputReport, $periodLabel, $start, $end, $outputRows, $outputSummaryRows, $placedCells, $autoload);
}

echo json_encode([
    'ok' => true,
    'id' => $id,
    'period' => (string)($report['period'] ?? 'month'),
    'period_label' => $periodLabel,
    'format' => $format,
    'output' => $output,
    'filename' => safe_filename((string)($report['name'] ?? $id)) . "-{$periodLabel}.{$format}",
    'rows' => count($rows),
    'truncated' => $truncated,
], JSON_UNESCAPED_SLASHES) . "\n";
